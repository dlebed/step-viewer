{
  "name": "STEP Viewer",
  "short_name": "STEP Viewer",
  "description": "STEP / IGES / BREP viewer with measurement tools. Runs offline in the browser.",
  "id": "./step-viewer.html",
  "start_url": "./step-viewer.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eceef1",
  "theme_color": "#ffffff",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./step-viewer.html",
      "accept": {
        "model/step": [".step", ".stp"],
        "model/iges": [".iges", ".igs"],
        "application/x-brep": [".brep", ".brp"]
      }
    }
  ]
}
